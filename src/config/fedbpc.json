{
    "data_setups":{
        "root": "../../data",
        "dataset_name": "cifar10",
        "batch_size": 50,
        "n_clients": 100,
        "partition": {
            "method": "sharding",
            "shard_per_user": 2
        }
    },
    "train_setups":{
        "algo": {
            "name": "fedbpc",
            "params": {
                "lambda_align": 0.1,
                "lambda_proto": 0.5,
                "proto_tau": 0.5,
                "proto_momentum": 0.5,
                "singleton_proto_update": {
                    "enabled": true,
                    "update_scale": 0.6666667
                },
                "min_confidence": 0.05,
                "min_proto_samples": 2,
                "count_shrinkage": 5.0,
                "min_proto_contributors": 1,
                "max_prototype_age": 5,
                "confidence_logit_norm_gamma": 0.05,
                "wrong_prediction_weight": 0.5,
                "class_balanced_loss": true,
                "min_proto_classes": 2,
                "head_agg": {
                    "enabled": false,
                    "gamma_logit": 0.5,
                    "gamma_update": 0.5,
                    "eps": 1e-8,
                    "head_keyword": "classifier"
                },
                "diagnostics": {
                    "enabled": true,
                    "shadow_eval_interval": 1,
                    "prototype_eval_interval": 1,
                    "prototype_eval_batches": 10,
                    "gradient_rounds": [1, 49, 99, 149, 199],
                    "gradient_client_slots": [0],
                    "log_client_slots": true
                }
            }
        },
        "scenario": {
            "n_rounds": 200,
            "sample_ratio": 0.1,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model":{
            "name": "fedavg_cifar",
            "params": {}
        },
        "optimizer":{
            "params": {"lr": 0.01, "momentum":0.9, "weight_decay": 1e-5}
        },
        "scheduler":{
            "enabled": true,
            "name": "step",
            "params": {"gamma":0.99, "step_size": 1}
        },
        "seed": 2022
    },
    "wandb_setups":{
        "project": "FedClsimb",
        "group": "fedbpc",
        "name": "fedbpc_1"
    }
}
