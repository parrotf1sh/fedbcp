{
    "data_setups": {
        "root": "../../data",
        "dataset_name": "cifar10",
        "batch_size": 50,
        "n_clients": 100,
        "partition": {
            "method": "lda",
            "alpha": 0.1
        }
    },
    "train_setups": {
        "algo": {
            "name": "fednh",
            "params": {
                "head_init": "orthogonal",
                "smoothing": 0.9,
                "client_adv_prototype_agg": false,
                "server_adv_prototype_agg": false,
                "fix_scaling": false,
                "scaling_init": null,
                "fixed_scaling": 30.0,
                "max_grad_norm": 10.0,
                "server_lr": 1.0,
                "server_lr_decay": 1.0,
                "client_lr_scheduler": "project",
                "client_lr_decay": 0.99,
                "exclude": []
            }
        },
        "scenario": {
            "n_rounds": 200,
            "sample_ratio": 0.1,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model": {
            "name": "fedavg_cifar",
            "params": {}
        },
        "optimizer": {
            "params": {
                "lr": 0.01,
                "momentum": 0.9,
                "weight_decay": 1e-5
            }
        },
        "scheduler": {
            "enabled": true,
            "name": "step",
            "params": {
                "gamma": 0.99,
                "step_size": 1
            }
        },
        "seed": 2022
    },
    "wandb_setups": {
        "project": "FedClsimb",
        "group": "fednh",
        "name": "fednh_test"
    }
}
