{
    "data_setups": {
        "root": "../../data",
        "dataset_name": "cifar10",
        "batch_size": 50,
        "n_clients": 100,
        "partition": {
            "method": "sharding",
            "shard_per_user": 2
        }
    },
    "train_setups": {
        "algo": {
            "name": "tinyproto",
            "params": {
                "lambda_proto": 10.0,
                "add_cps": true,
                "cps_ratio": 10,
                "simple_scale": true,
                "constant_scale_factor": 0.00015,
                "mask_max_attempts": 10000,
                "mask_cache_path": null
            }
        },
        "scenario": {
            "n_rounds": 200,
            "sample_ratio": 0.1,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model": {
            "name": "fedavg_cifar",
            "params": {}
        },
        "optimizer": {
            "name": "sgd",
            "params": {
                "lr": 0.01
            }
        },
        "scheduler": {
            "enabled": false,
            "name": "step",
            "params": {
                "gamma": 0.99,
                "step_size": 1
            }
        },
        "seed": 2022
    },
    "swanlab_setups": {
        "project": "FedClsimb",
        "group": "tinyproto",
        "experiment_name": "tinyproto_cifar10_sharding",
        "workspace": null
    }
}
