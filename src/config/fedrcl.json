{
    "data_setups": {
        "root": "../../data",
        "dataset_name": "cifar10",
        "batch_size": 50,
        "n_clients": 100,
        "partition": {
            "method": "sharding",
            "shard_per_user": 2
        }
    },
    "train_setups": {
        "algo": {
            "name": "fedrcl",
            "params": {
                "ce_loss": {"weight": 1.0},
                "prox_loss": {"weight": 0.0},
                "feature_align_loss": {"weight": 0.0, "align_type": "cosine"},
                "rcl_loss": {
                    "loss_type": "supervised",
                    "topk_pos": 1,
                    "topk_neg": 2,
                    "temp": 0.05,
                    "pairs": [
                        {
                            "name": "scl",
                            "pos": "nn",
                            "neg": "nn",
                            "weight": 1.0,
                            "loss_type": "supervised"
                        },
                        {
                            "name": "penalty",
                            "pos": "nn",
                            "neg": "nn",
                            "weight": 1.0,
                            "loss_type": "unsupervised",
                            "neg_sample_type": "intra_class_thresholding",
                            "threshold": 0.7
                        }
                    ],
                    "weight": 1.0,
                    "branch_level": null,
                    "feature_relu": false
                },
                "local_lr_decay": 0.998,
                "grad_clip": 10.0,
                "use_amp": true,
                "metrics_only": false
            }
        },
        "scenario": {
            "n_rounds": 200,
            "sample_ratio": 0.1,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model": {
            "name": "fedavg_cifar",
            "params": {}
        },
        "optimizer": {
            "params": {"lr": 0.01, "momentum": 0.9, "weight_decay": 1e-5}
        },
        "scheduler": {
            "enabled": true,
            "name": "step",
            "params": {"gamma": 0.99, "step_size": 1}
        },
        "seed": 2022
    },
    "wandb_setups": {
        "project": "FedClsimb",
        "group": "fedrcl",
        "name": "fedrcl_1"
    }
}
