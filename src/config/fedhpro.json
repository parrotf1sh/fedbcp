{
    "data_setups": {
        "root": "../../data",
        "dataset_name": "cifar10",
        "batch_size": 50,
        "n_clients": 100,
        "partition": {
            "method": "sharding",
            "shard_per_user": 2
        }
    },
    "train_setups": {
        "algo": {
            "name": "fedhpro",
            "params": {
                "length_of_hp": 5,
                "rounds_of_hp": 30,
                "hp_info_t": 0.05,
                "lr_hp": 0.1,
                "meta_length": 50,
                "batch_real": 100,
                "repeat_num": 1,
                "use_margin": false,
                "dis_metric": "matching",
                "meta_rounds": 100,
                "meta_epochs": 100,
                "meta_lr": 0.01,
                "meta_batch_size": 50,
                "margin_batch_size": 100,
                "method": "DSA",
                "dsa_strategy": "color_crop_cutout_flip_scale_rotate",
                "augmentation": {
                    "aug_mode": "S",
                    "prob_flip": 0.5,
                    "ratio_scale": 1.2,
                    "ratio_rotate": 15.0,
                    "ratio_crop_pad": 0.125,
                    "ratio_cutout": 0.5,
                    "ratio_noise": 0.05,
                    "brightness": 1.0,
                    "saturation": 2.0,
                    "contrast": 0.5
                }
            }
        },
        "scenario": {
            "n_rounds": 200,
            "sample_ratio": 0.1,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model": {
            "name": "fedavg_cifar",
            "params": {}
        },
        "optimizer": {
            "params": {
                "lr": 0.01,
                "momentum": 0.9,
                "weight_decay": 1e-05
            }
        },
        "scheduler": {
            "enabled": true,
            "name": "step",
            "params": {
                "gamma": 0.99,
                "step_size": 1
            }
        },
        "seed": 2022
    },
    "wandb_setups": {
        "project": "FedClsimb",
        "group": "fedhpro",
        "name": "fedhpro_1"
    }
}
