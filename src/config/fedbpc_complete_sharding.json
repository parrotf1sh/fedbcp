{
    "data_setups": {
        "root": "../../data",
        "dataset_name": "cifar10",
        "batch_size": 50,
        "n_clients": 100,
        "partition": {
            "method": "sharding",
            "shard_per_user": 2
        }
    },
    "train_setups": {
        "algo": {
            "name": "fedbpc_complete",
            "params": {
                "completion_strength": 0.5,
                "lambda_align": 0.1,
                "variance_scale": 1.0,
                "preserve_backbone_gradients": true,
                "warmup_rounds": 1,
                "max_prototype_age": 5,
                "statistics_num_workers": 0
            }
        },
        "scenario": {
            "n_rounds": 200,
            "sample_ratio": 0.1,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model": {
            "name": "fedavg_cifar",
            "params": {}
        },
        "optimizer": {
            "params": {
                "lr": 0.01,
                "momentum": 0.9,
                "weight_decay": 1e-05
            }
        },
        "scheduler": {
            "enabled": true,
            "name": "step",
            "params": {
                "gamma": 0.99,
                "step_size": 1
            }
        },
        "seed": 2022
    },
    "swanlab_setups": {
        "project": "FedClsimb",
        "group": "fedbpc_complete",
        "experiment_name": "fedbpc_complete_sharding_seed2022",
        "mode": "offline",
        "workspace": null
    },
    "batch_protocol": {
        "output_dir": "../fedbpc_complete_experiments/sharding_seed2022",
        "download_if_missing": false,
        "save_checkpoints": true,
        "model_aggregation": "sample_weighted"
    }
}
