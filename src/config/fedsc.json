{
    "data_setups": {
        "root": "../../data",
        "dataset_name": "cifar10",
        "batch_size": 50,
        "n_clients": 100,
        "partition": {
            "method": "sharding",
            "shard_per_user": 2
        }
    },
    "train_setups": {
        "algo": {
            "name": "fedsc",
            "params": {
                "cl_tau": 0.05
            }
        },
        "scenario": {
            "n_rounds": 200,
            "sample_ratio": 0.1,
            "local_epochs": 5,
            "device": "cuda:0"
        },
        "model": {
            "name": "fedavg_cifar",
            "params": {}
        },
        "optimizer": {
            "params": {
                "lr": 0.01,
                "momentum": 0.9,
                "weight_decay": 1e-05
            }
        },
        "scheduler": {
            "enabled": true,
            "name": "step",
            "params": {
                "gamma": 0.99,
                "step_size": 1
            }
        },
        "seed": 2022
    },
    "swanlab_setups": {
        "project": "FedClsimb",
        "group": "fedsc",
        "experiment_name": "fedsc_cifar10_sharding_source",
        "workspace": null
    }
}
